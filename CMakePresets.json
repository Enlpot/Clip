{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 2,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-msvc-base",
      "hidden": true,
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "toolset": "host=x64,version=14.51",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "${sourceDir}/.tools/vcpkg/scripts/buildsystems/vcpkg.cmake",
      "environment": {
        "VCPKG_ROOT": "${sourceDir}/.tools/vcpkg"
      },
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_CXX_EXTENSIONS": "OFF",
        "CLIP_APPS_ENABLE_RELEASE_OPTIMIZATION": "ON",
        "CLIP_APPS_ENABLE_RELEASE_SIZE_OPTIMIZATION": "OFF",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/.tools/vcpkg/installed/dynamic",
        "VCPKG_OVERLAY_PORTS": "${sourceDir}/cmake/vcpkg-overlay-ports/crashpad;${sourceDir}/cmake/vcpkg-overlay-ports/ffmpeg;${sourceDir}/cmake/vcpkg-overlay-ports/ffmpeg-bin2c;${sourceDir}/cmake/vcpkg-overlay-ports/libde265;${sourceDir}/cmake/vcpkg-overlay-ports/libheif;${sourceDir}/cmake/vcpkg-overlay-ports/libjxl;${sourceDir}/cmake/vcpkg-overlay-ports/libvpl;${sourceDir}/cmake/vcpkg-overlay-ports/amd-amf;${sourceDir}/cmake/vcpkg-overlay-ports/minizip-ng;${sourceDir}/cmake/vcpkg-overlay-ports/onnx;${sourceDir}/cmake/vcpkg-overlay-ports/onnxruntime;${sourceDir}/cmake/vcpkg-overlay-ports/opencv4;${sourceDir}/cmake/vcpkg-overlay-ports/x264;${sourceDir}/cmake/vcpkg-overlay-ports/x265;${sourceDir}/cmake/vcpkg-overlay-ports/zlib",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/vcpkg-overlay-triplets",
        "VCPKG_MANIFEST_INSTALL": "ON",
        "VCPKG_MANIFEST_FEATURES": "clip-shot;full-codecs;image-viewer",
        "CLIP_APPS_STRICT_COMPILE": "ON",
        "CLIP_APPS_ENABLE_CLANG_TIDY": "OFF",
        "CLIP_APPS_BUILD_ANT_DESIGN_QT": "ON",
        "CLIP_APPS_BUILD_CLIP_IMAGE": "ON",
        "CLIP_APPS_BUILD_DRAW_ENGINE": "ON",
        "CLIP_APPS_BUILD_IMAGE_VIEWER": "ON",
        "CLIP_APPS_BUILD_CLIP_SHOT": "ON",
        "CLIP_APPS_BUILD_CLIP_SHOT_MINI": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-msvc-debug",
      "displayName": "Windows MSVC Debug",
      "inherits": "windows-msvc-base",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreadedDebugDLL",
        "CLIP_APPS_BUILD_TESTS": "ON",
        "CLIP_APPS_BUILD_BENCHMARKS": "OFF",
        "CLIP_APPS_RELEASE_STATIC": "OFF",
        "CLIP_APPS_PACKAGE_CLIP_SHOT": "OFF",
        "CLIP_APPS_API_BASE_URL": "http://localhost:8080",
        "CLIP_IMAGE_PROFILE": "full",
        "CLIP_IMAGE_DEFAULT_LINKAGE": "static"
      }
    },
    {
      "name": "windows-msvc-performance",
      "displayName": "Windows MSVC Performance",
      "inherits": "windows-msvc-base",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Release",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreadedDLL",
        "CLIP_APPS_BUILD_TESTS": "ON",
        "CLIP_APPS_BUILD_BENCHMARKS": "ON",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION_RELEASE": "ON",
        "CLIP_APPS_RELEASE_STATIC": "OFF",
        "CLIP_APPS_PACKAGE_CLIP_SHOT": "OFF",
        "CLIP_APPS_API_BASE_URL": "https://clipshot.top",
        "CLIP_IMAGE_PROFILE": "full",
        "CLIP_IMAGE_DEFAULT_LINKAGE": "static"
      }
    },
    {
      "name": "windows-clang-portability",
      "displayName": "Windows Clang portability diagnostics",
      "inherits": "windows-msvc-base",
      "generator": "Ninja",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "toolset": {
        "value": "host=x64,version=14.51",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang-cl",
        "CLIP_APPS_BUILD_TESTS": "OFF",
        "CLIP_APPS_BUILD_BENCHMARKS": "OFF",
        "CLIP_APPS_RELEASE_STATIC": "OFF",
        "CLIP_APPS_PACKAGE_CLIP_SHOT": "OFF",
        "CLIP_APPS_API_BASE_URL": "http://localhost:8080",
        "CLIP_IMAGE_PROFILE": "full",
        "CLIP_IMAGE_DEFAULT_LINKAGE": "static"
      }
    },
    {
      "name": "clip-shot-msvc-release",
      "displayName": "Clip MSVC Static Qt Release",
      "inherits": "windows-msvc-base",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Release",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/.tools/vcpkg/installed/static",
        "VCPKG_MANIFEST_FEATURES": "clip-shot",
        "CLIP_APPS_BUILD_ANT_DESIGN_QT": "ON",
        "CLIP_APPS_BUILD_CLIP_IMAGE": "ON",
        "CLIP_APPS_BUILD_DRAW_ENGINE": "ON",
        "CLIP_APPS_BUILD_IMAGE_VIEWER": "OFF",
        "CLIP_APPS_BUILD_CLIP_SHOT": "ON",
        "CLIP_APPS_BUILD_TESTS": "OFF",
        "CLIP_APPS_BUILD_BENCHMARKS": "OFF",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION_RELEASE": "ON",
        "CLIP_APPS_ENABLE_RELEASE_SIZE_OPTIMIZATION": "ON",
        "CLIP_APPS_RELEASE_STATIC": "ON",
        "CLIP_APPS_QT_STATIC": "ON",
        "CLIP_APPS_PACKAGE_CLIP_SHOT": "ON",
        "CLIP_APPS_API_BASE_URL": "https://clipshot.top",
        "CLIP_IMAGE_PROFILE": "redistributable",
        "CLIP_IMAGE_DEFAULT_LINKAGE": "static"
      }
    },
    {
      "name": "clip-shot-msvc-fast",
      "displayName": "Clip MSVC Fast Static Build",
      "inherits": "clip-shot-msvc-release",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CLIP_APPS_ENABLE_RELEASE_OPTIMIZATION": "OFF",
        "CLIP_APPS_ENABLE_RELEASE_SIZE_OPTIMIZATION": "OFF",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION_RELEASE": "OFF",
        "CLIP_APPS_PACKAGE_CLIP_SHOT": "OFF",
        "CLIP_RUST_RELEASE_PROFILE": "release-fast"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "build-windows-msvc-debug",
      "configurePreset": "windows-msvc-debug",
      "configuration": "Debug",
      "targets": [
        "clip-all"
      ]
    },
    {
      "name": "build-windows-msvc-performance",
      "configurePreset": "windows-msvc-performance",
      "configuration": "Release",
      "targets": [
        "clip-all"
      ]
    },
    {
      "name": "build-windows-clang-portability",
      "configurePreset": "windows-clang-portability",
      "targets": [
        "clip-all"
      ]
    },
    {
      "name": "build-clip-shot-msvc-release",
      "configurePreset": "clip-shot-msvc-release",
      "configuration": "Release",
      "targets": [
        "clip_shot",
        "clip_shot_mini"
      ]
    },
    {
      "name": "build-clip-shot-msvc-fast",
      "configurePreset": "clip-shot-msvc-fast",
      "configuration": "Release",
      "targets": [
        "clip_shot",
        "clip_shot_mini"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "test-windows-msvc-debug",
      "configurePreset": "windows-msvc-debug",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "exclude": {
          "label": "interactive|e2e|benchmark"
        }
      }
    },
    {
      "name": "test-windows-msvc-performance",
      "configurePreset": "windows-msvc-performance",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "exclude": {
          "label": "interactive|e2e|benchmark"
        }
      }
    },
    {
      "name": "test-windows-msvc-interactive",
      "configurePreset": "windows-msvc-debug",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "interactive"
        }
      }
    }
  ],
  "packagePresets": [
    {
      "name": "package-clip-shot",
      "configurePreset": "clip-shot-msvc-release",
      "generators": [
        "NSIS"
      ]
    }
  ]
}
